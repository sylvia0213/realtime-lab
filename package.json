{
  "name": "yingying-realtime-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A reproducible React realtime data lab and Chinese engineering journal.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/content.mjs && vite --host 127.0.0.1 --port 4178",
    "build": "node scripts/content.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "test": "node --import tsx --test tests/*.test.ts",
    "mock-server": "node --import tsx scripts/mock-server.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "ws": "8.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
